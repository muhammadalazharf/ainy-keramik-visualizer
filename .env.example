# Ainy Keramik Visualizer — Environment Variables Template
#
# Copy file ini ke `.env.local` (auto-loaded oleh Next.js di dev),
# atau set langsung di Vercel dashboard untuk production/preview.
#
# JANGAN pernah commit `.env.local` atau `.env` ke git (sudah di-ignore).

# ─── AUTH ────────────────────────────────────────────────────────────
# Bcrypt hash password toko. Generate via:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# Contoh (bukan password real): $2b$10$abcdef1234567890...
APP_PASSWORD_HASH=

# Secret untuk sign session cookie. Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Durasi session dalam hari (default 30)
SESSION_MAX_AGE_DAYS=30

# ─── DEPLOY ──────────────────────────────────────────────────────────
# Set otomatis oleh Vercel — jangan diedit di sini
# NEXT_PUBLIC_VERCEL_URL (set by Vercel)
# VERCEL_ENV=preview|production (set by Vercel)
